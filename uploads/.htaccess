# ==============================================================================
# Uploads Security Configuration
# Prevent script execution inside upload directory
# ==============================================================================

# Disable directory browsing
Options -Indexes

# Disable PHP execution
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Block all executable file extensions
<FilesMatch "\.(php|php3|php4|php5|phtml|pl|py|cgi|sh|bash|exe|asp|aspx|jsp|phar)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Only allow safe media types to be requested
<FilesMatch "\.(jpg|jpeg|png|webp|gif|svg|pdf)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
</FilesMatch>
