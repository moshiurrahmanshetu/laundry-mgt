# ==============================================================================
# Security & Access Control Configuration
# Project: Laundry Management System (laundry-mgt)
# ==============================================================================

# Disable directory browsing
Options -Indexes

# Protect sensitive file extensions from direct access
<FilesMatch "\.(sql|env|log|md|git|json|lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Protect sensitive directories from direct browsing
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^config/ - [F,L]
    RewriteRule ^storage/ - [F,L]
    RewriteRule ^database/ - [F,L]
</IfModule>
